{
  "manifest_version": 3,
  "name": "Pintia 学习辅助工具",
  "version": "1.0.0",
  "description": "整理 Pintia 作业题目，导出结构化数据，并提供可选的 AI 学习辅助。",
  "permissions": ["activeTab", "downloads", "storage"],
  "host_permissions": ["https://pintia.cn/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Pintia 学习辅助工具",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://pintia.cn/*"],
      "js": [
        "src/content/extractor-common.js",
        "src/content/api-extractor.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
