{
  "manifest_version": 3,
  "name": "Pintia 学习辅助工具",
  "version": "1.0.6",
  "description": "Pintia 学习辅助工具，包含题目识别、题目导出、AI辅助学习、答案回填等功能。",
  "permissions": ["activeTab", "storage", "downloads"],
  "host_permissions": ["https://pintia.cn/*", "https://api.github.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Pintia 学习辅助工具",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://pintia.cn/*"],
      "js": [
        "src/shared/prompt-builder.js",
        "src/shared/answer-contract.js",
        "src/content/extractor-common.js",
        "src/content/api-extractor.js",
        "src/content/answer-runner.js",
        "src/content/assistant-panel.js",
        "src/content/content.js"
      ],
      "css": ["src/content/assistant-panel.css"],
      "run_at": "document_idle"
    }
  ]
}
